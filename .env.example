# Server Configuration
PORT=5005
NODE_ENV=development

# Admin Authentication Secret
JWT_SECRET=change_me_to_a_long_random_string
# Initial admin password (used only when data/admin.json does not exist yet)
ADMIN_PASSWORD=

# Email / SMTP Configuration (Optional: for sending contact inquiries & reset codes via email)
# Can use Ambition Host cPanel Webmail SMTP, Gmail App Password, or any SMTP provider:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Venus Hospital Doors" <no-reply@venushospitaldoors.com>
ADMIN_RECEIVER_EMAIL=venushospitaldoorsolutions@gmail.com
